# Copy this file to .env (or set these as real environment variables in
# Vercel's project settings) and fill in your actual Neon connection string.

# Get this from your Neon project dashboard -> Connection Details.
# It looks like:
#   postgres://<user>:<password>@<host>.neon.tech/<database>?sslmode=require
# In production, use Neon's POOLED connection string (hostname contains
# "-pooler") -- see VERCEL_ARCHITECTURE.md.
DATABASE_URL=

# Used by app.js (the new production app) to sign stateless auth cookies.
# Any long random string -- e.g. generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Used only by the Vercel Cron HTTP endpoint (/api/cron/generate-monthly-rent).
# Not needed if you're triggering jobs/generate-monthly-rent.js from a
# native cron job (e.g. on a CWP VPS) instead -- that path doesn't go
# through HTTP at all. Generate one the same way as JWT_SECRET.
CRON_SECRET=

# Only used by the existing (pre-Postgres) SQLite app in server.js -- not
# needed once the app is migrated onto the schema in db/migrations/.
SESSION_SECRET=change-me-to-a-long-random-string
